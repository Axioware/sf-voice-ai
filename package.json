{
  "name": "sf-voice-ai",
  "version": "1.0.0",
  "description": "Salesforce real-time voice AI assistant using Deepgram STT and Claude LLM",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "NODE_ENV=development electron .",
    "build": "electron-builder --linux",
    "build:win": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --dir && node -e \"const {execSync}=require('child_process'),v=require('./package.json').version;execSync('cd dist && zip -r \\\"SF-Voice-AI-'+v+'-win.zip\\\" win-unpacked/',{stdio:'inherit'});console.log('→ dist/SF-Voice-AI-'+v+'-win.zip')\"",
    "build:mac": "electron-builder --mac",
    "build:all": "electron-builder --linux --win --mac",
    "dist": "electron-builder --linux --publish=never"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.20.0",
    "@deepgram/sdk": "^4.0.0",
    "dotenv": "^16.0.0",
    "electron-store": "^8.1.0",
    "node-record-lpcm16": "^1.0.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.yourcompany.sf-voice-ai",
    "productName": "SF Voice AI",
    "copyright": "Copyright © 2024",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "services/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "!node_modules/.cache",
      "!**/*.map",
      "!.env",
      "!.env.*",
      "!.git/**"
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "Office",
      "description": "Salesforce Voice AI Assistant"
    },
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "sign": null,
      "extraResources": [
        {
          "from": "assets/bin/ffmpeg.exe",
          "to": "ffmpeg.exe"
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.business"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "appImage": {
      "artifactName": "SF-Voice-AI-${version}.AppImage"
    },
    "deb": {
      "artifactName": "SF-Voice-AI-${version}.deb",
      "depends": [
        "pulseaudio-utils",
        "sox"
      ]
    }
  },
  "author": {
    "name": "Rauf",
    "email": "abdulraufsiddiqui1999@gmail.com"
  }
}