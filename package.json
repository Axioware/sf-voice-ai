{
  "name": "sf-voice-ai",
  "version": "1.0.0",
  "description": "Salesforce real-time voice AI assistant using Deepgram STT and Claude LLM",
  "main": "main.js",
  "author": {
    "name": "Rauf",
    "email": "abdulraufsiddiqui1999@gmail.com"
  },
  "scripts": {
    "start": "electron .",
    "dev": "NODE_ENV=development electron .",
    "build:linux": "electron-builder --linux",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:all": "electron-builder --linux --win --mac"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.20.0",
    "@deepgram/sdk": "^4.0.0",
    "dotenv": "^16.0.0",
    "electron-store": "^8.1.0",
    "node-record-lpcm16": "^1.0.1",
    "uuid": "^9.0.0",
    "wav": "^1.0.2"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.yourcompany.sf-voice-ai",
    "productName": "SF Voice AI",
    "copyright": "Copyright © 2024 Rauf",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "services/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "!node_modules/.cache",
      "!**/*.map",
      "!.env",
      "!.env.*",
      "!.git/**",
      "!test-audio/**",
      "!test-simulation.sh",
      "!*.log"
    ],
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "Office",
      "description": "Salesforce Voice AI Assistant"
    },
    "deb": {
      "artifactName": "SF-Voice-AI-${version}-linux.deb",
      "depends": [
        "ffmpeg"
      ]
    },
    "appImage": {
      "artifactName": "SF-Voice-AI-${version}-linux.AppImage"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "artifactName": "SF-Voice-AI-${version}-windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerHeaderIcon": "assets/icon.png",
      "artifactName": "SF-Voice-AI-${version}-windows-setup.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.business",
      "artifactName": "SF-Voice-AI-${version}-mac.dmg"
    },
    "dmg": {
      "title": "SF Voice AI",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
