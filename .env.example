# SF Voice AI — environment config
# Copy this file to .env and fill in the values you have.
#
# Note: values entered later in the app's Settings screen take precedence
# over these once saved (see syncEnvToStore() in main.js) — so it's fine to
# leave this file mostly empty and configure everything from Settings instead.

# ── Required ─────────────────────────────────────────────────────────────────
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=

# ── Optional — Salesforce lead lookup by phone number ──────────────────────
# Leave these blank to skip Salesforce entirely; the app still works with
# transcript-only suggestions. See README.md#salesforce-lead-lookup for how
# to set up the Connected App and get a refresh token.
SF_INSTANCE_URL=
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_REFRESH_TOKEN=
